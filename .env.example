# ─── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=project-place
POSTGRES_PASSWORD=project-place
POSTGRES_DB=project-place

# ─── Подключение к БД (для Spring-сервисов) ─────────────────────
DB_URL=jdbc:postgresql://trackme-postgres:5432/project-place
DB_USERNAME=project-place
DB_PASSWORD=project-place
BACKEND_DB_SCHEMA=backend
MEETING_DB_SCHEMA=meeting_service

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=trackme-redis
REDIS_PORT=6380
REDIS_PASSWORD=changeme
REDIS_USER=trackme
REDIS_USER_PASSWORD=changeme

# ─── Kafka ──────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=trackme-kafka:9092

# ─── JWT / Auth ─────────────────────────────────────────────────
# Сгенерируй SHA-512 хеш: https://emn178.github.io/online-tools/sha512.html
JWT_SECRET=CHANGE_ME_TO_SHA512_HASH

# ─── SSO / OAuth2 ──────────────────────────────────────────────
SSO_URI=http://trackme-sso:9000
TRACKME_CLIENT_ID=trackme-client
TRACKME_CLIENT_SECRET=changeme
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── URIs (внутри Docker-сети) ──────────────────────────────────
BACKEND_URI=http://trackme-backend:8080
FRONTEND_URI=http://localhost:3000
TELEGRAM_URI=http://telegram-service:8084

# ─── Redirect / Cookie ─────────────────────────────────────────
AFTER_LOGIN_URL=http://localhost:3000
AFTER_LOGOUT_URI=http://localhost:3000
ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_SECURE=false
SSO_COOKIE_DOMAIN=

# ─── Mail (опционально) ────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@trackme.local
MAIL_SUBJECT=Track Me
MAIL_SUMMARY_SEND_ROLES=

# ─── Telegram Bot (опционально) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Прочее ─────────────────────────────────────────────────────
APP_NAME=Track Me
