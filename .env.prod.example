# Шаблон .env для PROD-стенда (docker-compose.prod.yaml).
# Скопируй в $HOME/track-me-prod/.env на сервере и подставь реальные значения.
# Отличия от dev: защищённые cookie, реальный домен, версионируемые образы.
# ВАЖНО: IMAGE_REPO и IMAGE_TAG патчит workflow deploy-prod — вручную их трогать не нужно.

# ─── Версии образов (управляются workflow deploy-prod) ──────────
# IMAGE_REPO=ghcr.io/students-buisness-incubator-of-tusur/track-me
# IMAGE_TAG=v0.0.0
# Тег образа фронтенда (отдельный репозиторий track-me-frontend):
FRONTEND_IMAGE=ghcr.io/akarmanov2022/track-me/frontend:latest

# ─── Внешний порт nginx (dev на этом же хосте занимает :80) ─────
PROXY_HTTP_PORT=8000

# ─── Spring profile ────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker-local

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=trackme-prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trackme-prod

# ─── Подключение к БД (для Spring-сервисов) ────────────────────
DB_URL=jdbc:postgresql://trackme-postgres:5432/trackme-prod
DB_USERNAME=trackme-prod
DB_PASSWORD=CHANGE_ME
BACKEND_DB_SCHEMA=backend
MEETING_DB_SCHEMA=meeting_service

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=trackme-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_USER=trackme
REDIS_USER_PASSWORD=CHANGE_ME

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=trackme-kafka:9092

# ─── JWT / Auth ────────────────────────────────────────────────
# SHA-512 хеш; сгенерировать отдельно от dev.
JWT_SECRET=CHANGE_ME_TO_SHA512_HASH

# ─── SSO / OAuth2 ──────────────────────────────────────────────
# ВСЕ домены ниже должны указывать на реальный prod-домен и совпадать с issuer SSO.
SSO_URI=https://trackme.example.org/sso/
TRACKME_CLIENT_ID=trackme-client
TRACKME_CLIENT_SECRET=CHANGE_ME
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── URIs (prod-домен) ─────────────────────────────────────────
BACKEND_URI=https://trackme.example.org/api/
FRONTEND_URI=https://trackme.example.org
TELEGRAM_URI=https://trackme.example.org/telegram/

# ─── Redirect / Cookie (prod: Secure + SameSite=None) ──────────
AFTER_LOGIN_URL=https://trackme.example.org
AFTER_LOGOUT_URI=https://trackme.example.org
ALLOWED_REDIRECT_ORIGINS=https://trackme.example.org
CORS_ORIGINS=https://trackme.example.org
SESSION_COOKIE_DOMAIN=trackme.example.org
SESSION_COOKIE_SAME_SITE=None
SESSION_COOKIE_SECURE=true
SSO_COOKIE_DOMAIN=trackme.example.org

# ─── Reverse proxy ─────────────────────────────────────────────
# За nginx стоит ещё один прокси/домен — доверяем forwarded-заголовкам.
SERVER_FORWARD_HEADERS_STRATEGY=native

# ─── Mail (опционально) ────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@trackme.example.org
MAIL_SUBJECT=Track Me

# ─── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME

# ─── Прочее ────────────────────────────────────────────────────
APP_NAME=Track Me
GATEWAY_LOG_LEVEL=INFO
