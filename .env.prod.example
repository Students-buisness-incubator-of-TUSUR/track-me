# Шаблон .env для PROD-стенда (docker/docker-compose.prod.yaml), домен trackme.startup-poligon.com.
# Скопируй в $HOME/track-me-prod/.env на сервере, подставь реальные значения и сделай chmod 600 .env.
# Секреты — ОТДЕЛЬНЫЕ от dev.
# ВАЖНО: IMAGE_REPO, IMAGE_TAG и GOOGLE_*/YANDEX_* патчит workflow deploy-prod (из секретов окружения
# production) — вручную их трогать не нужно.

# ─── Версии образов (управляются workflow deploy-prod) ──────────
# IMAGE_REPO=ghcr.io/students-buisness-incubator-of-tusur/track-me
# IMAGE_TAG=v0.0.0
# Образ фронтенда (отдельный репозиторий track-me-frontend). Для prod — зафиксированный тег, не :latest.
FRONTEND_IMAGE=ghcr.io/students-buisness-incubator-of-tusur/track-me-frontend:CHANGE_ME
# Адрес API для фронтенда (gateway).
REACT_APP_BACKEND_URI=https://api.trackme.startup-poligon.com

# ─── Spring profile ────────────────────────────────────────────
# production: Liquibase только с context prod (без тестовых пользователей dev), строгие cookie/CORS,
# Swagger в gateway выключен. НЕ использовать docker-local — там issuer зашит на host.docker.internal.
SPRING_PROFILES_ACTIVE=production

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=trackme-prod
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trackme-prod

# ─── Подключение к БД (для Spring-сервисов) ────────────────────
DB_URL=jdbc:postgresql://trackme-postgres:5432/trackme-prod
DB_USERNAME=trackme-prod
DB_PASSWORD=CHANGE_ME
BACKEND_DB_SCHEMA=backend
MEETING_DB_SCHEMA=meeting_service

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=trackme-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_USER=trackme
REDIS_USER_PASSWORD=CHANGE_ME

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=trackme-kafka:9092

# ─── JWT / Auth ────────────────────────────────────────────────
# SHA-512 хеш; сгенерировать отдельно от dev.
JWT_SECRET=CHANGE_ME_TO_SHA512_HASH

# ─── SSO / OAuth2 ──────────────────────────────────────────────
# Issuer SSO: должен совпадать во всех сервисах и быть доступен из контейнеров (через host-nginx).
SSO_URI=https://sso.trackme.startup-poligon.com
LOGOUT_URI=https://sso.trackme.startup-poligon.com/connect/logout
TRACKME_CLIENT_ID=trackme-client
# Должен соответствовать bcrypt-хешу client-secret в
# services/trackme-sso/src/main/resources/application-security.yaml (как на dev).
TRACKME_CLIENT_SECRET=CHANGE_ME
# Optional override; otherwise derived from SSO_URI.
# SSO_REGISTRATION_URL=https://sso.trackme.startup-poligon.com/client/registration

# ─── URIs ──────────────────────────────────────────────────────
# BACKEND_URI — публичный адрес gateway (без /api): из него строятся redirect-uri OAuth2 и api-url сервисов.
BACKEND_URI=https://api.trackme.startup-poligon.com
FRONTEND_URI=https://trackme.startup-poligon.com
TELEGRAM_URI=https://t.me

# ─── Redirect / Cookie / CORS ──────────────────────────────────
AFTER_LOGIN_URL=https://trackme.startup-poligon.com/after-login
AFTER_LOGOUT_URI=https://trackme.startup-poligon.com
ALLOWED_REDIRECT_ORIGINS=https://trackme.startup-poligon.com
CORS_ORIGINS=https://trackme.startup-poligon.com
# Пусто = host-only cookie на api.trackme… (как на dev): фронт и api — same-site, cookie уходит в XHR.
SESSION_COOKIE_DOMAIN=
# Временная cookie регистрации SSO; домен покрывает sso.trackme….
SSO_COOKIE_DOMAIN=trackme.startup-poligon.com
# Lax, а не Strict (дефолт профиля production): при Strict сессионная cookie не приходит на callback
# после входа через Google/Yandex. Все поддомены trackme.startup-poligon.com — same-site.
# (На dev стоит None + Secure — запасной вариант, если с Lax что-то не заработает.)
SESSION_COOKIE_SAME_SITE=Lax
SESSION_COOKIE_SECURE=true

# ─── Reverse proxy ─────────────────────────────────────────────
# TLS терминирует host-nginx — доверяем X-Forwarded-* заголовкам.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ─── Mail ──────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_SSL_ENABLED=false
MAIL_STARTTLS_ENABLED=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@trackme.startup-poligon.com
MAIL_SUBJECT=Track Me
# Пока SMTP не настроен — иначе /actuator/health будет DOWN и healthcheck не пройдёт.
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# ─── Telegram Bot (отдельный от dev бот) ───────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME

# ─── Прочее ────────────────────────────────────────────────────
APP_NAME=Track Me
GATEWAY_LOG_LEVEL=INFO
